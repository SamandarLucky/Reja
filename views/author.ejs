<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/main.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css">

    <title>Portfolio</title>
</head>

<body>

<div class="frame">
    <div class="main_frame">

        <!--left frame quramiz-->

        <div class="left_frame">
            <div class="left_1">
                <div class="left_1_1">
                    <img src="images/profile.png"
                         width="156"
                         height="142"
                         alt="profile">
                </div>
                <div class="left_1_2">
                    <%= user.name %>
                </div>
                <div class="left_1_3">
                    <%= user.profession %>
                </div>

                <div class="left_icons">
                    <a href="#" class="link_href">
                        <div class="icon">
                            <img src="icons/Icons-facebook.png"
                                 class="icon-1">
                        </div>
                    </a>
                    <a href="#" class="link_href">
                        <div class="icon">
                            <img src="icons/Icons-instagram.png"
                                 class="icon-1">
                        </div>
                    </a>
                    <a href="#" class="link_href">
                        <div class="icon">
                            <img src="icons/Icons-twitter.png"
                                 class="icon-1">
                        </div>
                    </a>
                    <a href="#" class="link_href">
                        <div class="icon">
                            <img src="icons/Icons-linkedin.png"
                                 class="icon-1">
                        </div>
                    </a>
                    <a href="#" class="link_href">
                        <div class="icon">
                            <img src="icons/Icons-dribbble.png"
                                 class="icon-1">
                        </div>
                    </a>
                </div>
            </div>

            <div class="marginer"></div>

            <div class="left_2">
                <h3>Personal Information</h3>
                <p>
                    <b>Age:</b>
                    <%= user.age %>
                </p>
                <p>
                    <b>Residence:</b>
                    <%= user.residence %>
                </p>
                <p>
                    <b>Address:</b>
                    <%= user.address %>
                </p>
                <p>
                    <b>City:</b>
                    <%= user.city %>
                </p>
            </div>

            <div class="marginer"></div>

            <div class="left_3">
                <h3>Languages</h3>
                <% user.languages.forEach(function(language) { %>
                    <p>
                        <%= language %>
                    </p>
                <% }) %>
            </div>

            <div class="marginer"></div>
        
            <div class="left_4">
                <h3>Skills</h3>
                <% user.skills.forEach(function(skill) { %>
                    <p>
                        <%= skill %>
                    </p>
                <% }) %>
            </div>

            <div class="marginer"></div>

            <div class="left_5">
                <h3>Extra Skills</h3>
                <% user.extra_skills.forEach(function(skill) { %>
                    <p>
                        <%= skill %>
                    </p>
                <% }) %>
            </div>
            
            <div class="marginer"></div>

        </div>

        <!--midd frame quramiz-->

        <div class="midd_frame">
            <div class="intro">
                <div class="right_side">
                <h1 style="margin-top: 100px;">
                    <%= user.profession %>
                </h1>
                <p style="margin-top: 18px;">
                    <%= user.about_me %>
                </p>
                <button class="btn-hire-me" style="background: #FFB400;">HIRE ME</button>
                </div>
                    <img src="images/yourimage.png">
                 </div>

            <div class="services">
                <h2>My Services</h2>
                <p>
                    <%= user.service_desc %>
                </p>
            <div class="my_services">
                <div class="service_list">
                    <div class="service">
                        <img src="images/coding.png" alt="">
                        <h3>WEB DEVELOPMENT</h3>
                        <p>Blog, E-Commerce</p>
                    </div>
                    <div class="service">
                        <img src="images/Icons_illustration.png" alt="">
                        <h3>UI-UX Design</h3>
                        <p>Mobile App, Website Design</p>
                    </div>
                    <div class="service">
                         <img src="images/Microphone.png" alt="">
                        <h3>Sound Design</h3>
                        <p>Voice Over, Beat Making</p>
                    </div>
                    <div class="service">
                         <img src="images/Icons_game-development.png" alt="">
                         <h3>Game Design</h3>
                        <p>Character Design, Props & Objects</p>
                    </div>
                    <div class="service">
                        <img src="images/Photographer.png" alt="">
                        <h3>PHOTOGRAPHY</h3>
                        <p>Portrait, Product photography</p>
                    </div>
                    <div class="service">
                        <h3>Advertising</h3>
                        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vitae nulla diam in ac dictum a urna viverra morbi.</p>
                        <a href="">Order Now</a>
                    </div>
                    
                </div>
            </div>
             </div>
        </div>

        <!-- right frame quramiz -->

        <div class="right_frame">
            <div class="contrast">
                <a href="">
                    <img src="icons/Contrast.png" alt="">
                </a>
            </div>
            <div class="menu">
           <div class="box_home">
            <a href="">
            <img src="icons/Home.png" alt="">
            </a>
           </div> 
           <div class="box">
            <a href="">
             <img src="icons/file-code.png" alt="">
             </a>
           </div>
           <div class="box">
            <a href="">
             <img src="icons/Icons_cv.png" alt="">
             </a>
           </div>
           <div class="box">
            <a href="">
             <img src="icons/Vector.png" alt="">
             </a>
           </div>
           <div class="box">
            <a href=""></a>
             <img src="icons/Blog.png" alt="">
             </a>
           </div>
           <div class="box">
            <a href="">
             <img src="icons/Icons_Contact.png" alt="">
             </a>
           </div>
           </div>
        </div>

</body>
</html>